rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access Firebase Auth custom claim se aata hai.
    // Claim grant karne ke liye: `npm run admin:grant -- email@example.com`
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Restaurants/menu sab padh sakte hain, lekin likhna sirf admin ka kaam hai.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();

      match /menu/{menuItemId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Home page ka "Most Sold Items" section `collectionGroup('menu')` use karta hai.
    // Collection group queries ke liye alag (path-agnostic) rule chahiye —
    // neeche wala nested rule sirf normal reads par lagta hai.
    match /{path=**}/menu/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    //  - create: sirf signed-in user, apne uid ke liye
    //  - read: apne orders, ya admin ko saare
    //  - update/delete: client se band
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'userId', 'customer', 'items', 'restaurantId', 'subtotal', 'total'
                       ])
                    && request.resource.data.items.size() > 0
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.customer.phone is string
                    && request.resource.data.customer.email == request.auth.token.email;

      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);

      // Admin order status badal sakta hai (sirf status + timeline history).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory'])
                    && request.resource.data.status in [
                         'placed', 'accepted', 'outForDelivery', 'delivered', 'cancelled'
                       ];
      allow delete: if false;
    }

    // Saved addresses — sirf owner apne addresses padh/likh sakta hai.
    match /users/{userId}/addresses/{addressId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, update, delete: if isOwner();

      allow create: if isOwner()
                    && request.resource.data.keys().hasAll(['label', 'address', 'phone', 'isDefault'])
                    && request.resource.data.label is string
                    && request.resource.data.label.size() > 0
                    && request.resource.data.address is string
                    && request.resource.data.address.size() >= 10
                    && request.resource.data.phone is string
                    && request.resource.data.isDefault is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
